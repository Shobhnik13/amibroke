{
  "name": "amibroke",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env run --cwd apps/api dev",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun --env-file=.env run packages/db/src/migrate.ts",
    "db:studio": "bun run --cwd packages/db studio",
    "db:seed": "bun --env-file=.env run packages/db/src/seed.ts"
  },
  "dependencies": {
    "@types/node": "^25.9.1"
  }
}
